# Copiar a docker/.env y completar antes de desplegar.
# NUNCA commitear el .env real (ya esta en .gitignore).

# --- Dominios (obligatorio: sin HTTPS, el navegador bloquea el microfono) ---
# Dos subdominios apuntando por DNS (registro A) a la IP del VPS:
#   LIVEKIT_DOMAIN -> todo el dominio queda reservado para LiveKit Server
#   APP_DOMAIN     -> landing page + servidor de tokens
# (ver docs/08-instalacion-despliegue.md para el porque de usar dos subdominios)
LIVEKIT_DOMAIN=livekit.tu-dominio.com
APP_DOMAIN=agente.tu-dominio.com
ACME_EMAIL=tu-correo@dominio.com

# --- Credenciales de LiveKit (inventar un par unico y secreto, no usar estos) ---
LIVEKIT_API_KEY=APIabcdef1234
LIVEKIT_API_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-caracteres

# URL interna (red docker) que usa el worker del agente para conectarse
LIVEKIT_URL=ws://livekit:7880
# URL publica (wss, SIN path) que usa el navegador del usuario
LIVEKIT_URL_PUBLIC=wss://livekit.tu-dominio.com

# --- Sala de la demo de la landing page ---
AGENT_ROOM_NAME=agente-voz-demo
CORS_ALLOW_ORIGINS=https://agente.tu-dominio.com

# --- LLM (Ollama) ---
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://ollama:11434/v1

# --- STT (faster-whisper) ---
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- TTS (Piper) ---
PIPER_VOICE=es_ES-davefx-medium
PIPER_BASE_URL=http://piper:5000
PIPER_SAMPLE_RATE=22050

# --- Idioma del agente ---
AGENT_LANGUAGE=es
